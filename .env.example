# Copy to .env and fill in. Nothing here is required to be a cloud service:
# the app runs locally with just a database and (for AI) a free Groq key.

# ── Database ────────────────────────────────────────────────────────────────
# Matches `docker compose up db`. Use any PostgreSQL 14+ URL.
DATABASE_URL=postgresql://campusgpt:campusgpt@localhost:5432/campusgpt

# ── AI (optional to boot; required for chat / voice) ───────────────────────
# Free key at https://console.groq.com. Without it the app still runs and AI
# endpoints return a clear 503.
GROQ_API_KEY=

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API cross-origin.
# Not needed when the site and API share one origin (the default setup).
CORS_ORIGINS=
# Serve a built frontend from the API server (set automatically in Docker).
# STATIC_DIR=artifacts/campus-gpt/dist/public

# ── Frontend dev server (pnpm dev) ──────────────────────────────────────────
# Where the Vite dev server proxies /api. Defaults to http://localhost:8080.
# API_PROXY_TARGET=http://localhost:8080

# ── Sign-in ─────────────────────────────────────────────────────────────────
# Only these email domains may create accounts (comma-separated). Leave empty
# to allow any email (local testing only).
ALLOWED_EMAIL_DOMAINS=st.ug.edu.gh
# REQUIRED in production: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the site, e.g. https://campusgpt.example. Used in email links.
BETTER_AUTH_URL=http://localhost:5173

# Verification / password-reset emails. Locally: `docker compose up -d mailpit`
# and read mail at http://localhost:8025. In production use any SMTP provider.
# With no SMTP_URL in development, links are printed in the API log instead.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=CampusGPT <no-reply@campusgpt.local>

# Optional social sign-in. Each button appears only when its keys are set.
# Microsoft: Entra admin center → App registrations. Redirect URI:
#   <BETTER_AUTH_URL>/api/auth/callback/microsoft
# Use your university's tenant ID to accept only its accounts.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Maps (optional) ─────────────────────────────────────────────────────────
# The app is moving to keyless OpenStreetMap maps/routing. A Google Maps key is
# only used if you set one; restrict it to your site's URL in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=
